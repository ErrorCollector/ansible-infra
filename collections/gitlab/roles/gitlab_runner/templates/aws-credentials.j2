# Managed by Ansible (errorcollector.gitlab.gitlab_runner): keys for the ECR credential helper
# (the same keys serve the S3 cache in config.toml)
[default]
aws_access_key_id = {{ gitlab_runner_aws_access_key_id }}
aws_secret_access_key = {{ gitlab_runner_aws_secret_access_key }}
region = {{ gitlab_runner_aws_region }}
