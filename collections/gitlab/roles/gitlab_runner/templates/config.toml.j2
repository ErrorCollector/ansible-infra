concurrent = {{ gitlab_runner_concurrent }}
check_interval = 0
shutdown_timeout = 0

[session_server]
  session_timeout = 1800

[[runners]]
  name = "{{ gitlab_runner_name }}"
  url = "{{ gitlab_runner_url }}"
  id = {{ gitlab_runner_id }}
  token = "{{ gitlab_runner_token }}"
  token_expires_at = 0001-01-01T00:00:00Z
  executor = "docker"
  request_concurrency = {{ gitlab_runner_request_concurrency }}
  environment = [
    "FF_USE_ADAPTIVE_REQUEST_CONCURRENCY=true"
  ]

{% if gitlab_runner_cache_type == 's3' %}
  # Cache shared by all runners in S3, expiry by a lifecycle rule on the bucket
  [runners.cache]
    Type = "s3"
    Shared = true
    MaxUploadedArchiveSize = 0
    [runners.cache.s3]
      ServerAddress = "{{ gitlab_runner_cache_s3_server }}"
      BucketName = "{{ gitlab_runner_cache_s3_bucket }}"
      BucketLocation = "{{ gitlab_runner_aws_region }}"
      AuthenticationType = "access-key"
      AccessKey = "{{ gitlab_runner_aws_access_key_id }}"
      SecretKey = "{{ gitlab_runner_aws_secret_access_key }}"
{% else %}
  [runners.cache]
    Type = "local"
    MaxUploadedArchiveSize = 0
{% endif %}

  [runners.docker]
    tls_verify = false
    image = "alpine:latest"
    privileged = {{ gitlab_runner_privileged | bool | lower }}
    disable_entrypoint_overwrite = false
    oom_kill_disable = false
    disable_cache = false
    volumes = [
      "{{ gitlab_runner_cache_dir }}:/cache"{% if gitlab_runner_docker_socket %},
      "/var/run/docker.sock:/var/run/docker.sock"{% endif %}

    ]
    shm_size = 0
    network_mtu = 0
