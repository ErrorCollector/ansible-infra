{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":semanticCommitTypeAll(fix)"
    ],
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0,
    "gitlabci": {
        "managerFilePatterns": [
            "/(^|/)\\.gitlab-ci\\.ya?ml$/",
            "/^collections/base/extras/gitlab-ci\\.yml$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Versions annotated with '# renovate:' comments in role defaults/vars",
            "managerFilePatterns": [
                "/^collections/[^/]+/roles/[^/]+/(defaults|vars)/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?( versioning=(?<versioning>\\S+))?\\n\\S+:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
            ]
        }
    ],
    "packageRules": [
        {
            "description": "Image/tool updates release the collection: fix = patch, major upstream updates = feat (minor while < 1.0)",
            "matchUpdateTypes": ["major"],
            "semanticCommitType": "feat"
        },
        {
            "description": "CI and dev tooling do not change the collections, no release",
            "matchManagers": ["github-actions", "pip_requirements"],
            "semanticCommitType": "ci",
            "semanticCommitScope": "deps"
        },
        {
            "description": "Pangolin server, Gerbil and Badger have to match, one MR",
            "matchPackageNames": ["docker.io/fosrl/pangolin", "docker.io/fosrl/gerbil", "fosrl/badger"],
            "groupName": "pangolin server",
            "semanticCommitScope": "pangolin"
        },
        {
            "description": "Runner follows the GitLab version, one MR",
            "matchPackageNames": ["gitlab/gitlab-ce", "gitlab/gitlab-runner"],
            "groupName": "gitlab",
            "semanticCommitScope": "gitlab"
        },
        {
            "description": "Registry database of the GitLab server: a major needs a dump/restore, never as update",
            "matchPackageNames": ["postgres"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "description": "Downloads verified against pinned checksums: CI fails until the checksums in the same defaults file are updated",
            "matchPackageNames": ["ajeetdsouza/zoxide", "awslabs/amazon-ecr-credential-helper"],
            "prBodyNotes": [
                "⚠️ Update the SHA256 checksums next to the version in the role defaults (scripts/check-checksums.py prints the expected values)."
            ]
        },
        {
            "description": "The Ansible image of the project jobs and the local container are the same",
            "matchPackageNames": ["alpine/ansible"],
            "groupName": "ansible image"
        }
    ]
}
